{
  "manifest_version": 3,
  "name": "AuraMusic - Personalizador Avanzado de YouTube Music",
  "version": "1.0.0",
  "description": "Temas visuales avanzados (OLED, Cyberpunk), visualizador en tiempo real, iluminación ambiental, ecualizador y sin anuncios.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AuraMusic Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "css": [
        "themes.css",
        "panel.css",
        "visualizer.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://music.youtube.com/*"
      ]
    }
  ]
}
