{
  "manifest_version": 3,
  "name": "AuraMusic - Personalizador Avanzado de YouTube Music",
  "version": "1.2.0",
  "description": "Temas visuales avanzados, modo letras animadas estilo Apple Music, visualizador en tiempo real, ecualizador y sin anuncios.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AuraMusic Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://music.youtube.com/*",
    "*://www.youtube.com/*",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "https://lrclib.net/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "css": [
        "themes.css",
        "panel.css",
        "visualizer.css",
        "cinema-lyrics.css"
      ],
      "js": [
        "three.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*"
      ],
      "matches": [
        "*://music.youtube.com/*"
      ]
    }
  ]
}
