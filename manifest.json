{
  "manifest_version": 3,
  "name": "AuraMusic - Personalizador Avanzado de YouTube Music",
  "version": "1.3.4",
  "description": "Temas visuales avanzados, letras animadas sincronizadas estilo Apple Music, visualizadores de audio en tiempo real y ecualizador.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AuraMusic Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://music.youtube.com/*",
    "*://www.youtube.com/*",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "https://lrclib.net/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "modules/core/player-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "css": [
        "splash.css"
      ],
      "js": [
        "modules/core/splash.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "css": [
        "themes.css",
        "panel.css",
        "visualizer.css",
        "cinema-lyrics.css"
      ],
      "js": [
        "modules/core/state.js",
        "modules/audio/audio-engine.js",
        "modules/visualizer/visualizer.js",
        "modules/ambient/ambient-glow.js",
        "modules/lyrics/cinema-lyrics.js",
        "modules/themes/theme-manager.js",
        "modules/hub/hub-panel.js",
        "modules/core/updater.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*",
        "diseños/*",
        "three.min.js",
        "modules/core/player-bridge.js"
      ],
      "matches": [
        "*://music.youtube.com/*"
      ]
    }
  ]
}
